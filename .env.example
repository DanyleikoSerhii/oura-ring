# Скопируйте в .env.local (файл игнорируется git) и заполните.
# 1. Создайте приложение: https://cloud.ouraring.com/oauth/applications
#    Redirect URI: http://localhost:9876/callback
# 2. Впишите Client ID и Client Secret и выполните: pnpm oura:auth
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Необязательно: порт redirect URI и список скоупов (по умолчанию см. tools/oura-tokens.ts)
# OURA_REDIRECT_PORT=9876
# OURA_SCOPES=

# Необязательно: готовый токен доступа вместо OAuth (например, старый личный токен, если он ещё действует)
# OURA_TOKEN=
